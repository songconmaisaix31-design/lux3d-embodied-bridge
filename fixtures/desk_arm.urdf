<?xml version="1.0"?>
<!-- A two-joint desk arm used by the offline demo. It is a stand-in for a
     real robot description: the bridge only needs a link whose collision
     geometry it can replace with a Lux3D-generated mesh. -->
<robot name="desk_arm">
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.12 0.12 0.05"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.12 0.12 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <inertia ixx="0.0020" ixy="0" ixz="0" iyy="0.0020" iyz="0" izz="0.0020"/>
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.30"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.04 0.30"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.0045" ixy="0" ixz="0" iyy="0.0045" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <link name="link2">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.20"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.20"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.0013" ixy="0" ixz="0" iyy="0.0013" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- the tool flange: this is the link whose collision geometry the bridge replaces -->
  <link name="tool">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="20" velocity="1.0"/>
    <dynamics damping="0.05"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="12" velocity="1.0"/>
    <dynamics damping="0.05"/>
  </joint>

  <joint name="joint_tool" type="fixed">
    <parent link="link2"/>
    <child link="tool"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
  </joint>
</robot>
